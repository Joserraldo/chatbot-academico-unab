# Copia este archivo a .env y llena los valores. .env NUNCA se sube a GitHub.
# Generar secretos aleatorios:  openssl rand -hex 24

# --- Dominio (DuckDNS) ---
DOMAIN=chatbot-unab.duckdns.org
ACME_EMAIL=correo-del-equipo@ejemplo.com
DUCKDNS_SUBDOMAIN=chatbot-unab
DUCKDNS_TOKEN=

# --- PostgreSQL ---
POSTGRES_USER=unab_admin
POSTGRES_PASSWORD=
APP_DB_PASSWORD=            # rol de solo lectura chatbot_ro (MCP server)

# --- n8n ---
N8N_VERSION=2.47.7
N8N_ENCRYPTION_KEY=         # NO cambiar después del primer arranque (cifra las credenciales)

# --- LLM de chat (b.ai u otro proveedor compatible con la API de OpenAI) ---
LLM_BASE_URL=https://api.b.ai/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash

# --- Embeddings multilingües locales, servidos por MCP ---
EMBED_BASE_URL=http://mcp-server:9000/v1
EMBED_API_KEY=               # genera un secreto independiente con openssl rand -hex 24
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- MCP server ---
MCP_TOKEN=                  # bearer token que exige el MCP server (n8n y Claude lo usan)

# --- Webhook del chat (la app Android envía este valor en X-Chatbot-Key) ---
CHATBOT_KEY=

# --- Calendario: Google Sheet publicado como CSV (Archivo > Compartir > Publicar en la web > CSV) ---
# Vacío = usa el respaldo /calendario.csv del MCP server (tabla calendario_evento)
SHEETS_CSV_URL=

SCRAPE_INTERVAL_HOURS=6
