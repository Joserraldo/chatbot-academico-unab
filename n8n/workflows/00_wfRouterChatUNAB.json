    {
      "id": "e1b17c76-10ab-5034-bc96-6ed6fdbc37f4",
      "name": "Guardrail salida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        300
      ],
      "parameters": {
        "jsCode": "// ===== Guardrail de SALIDA =====\nconst req = $('Guardrail entrada').first().json;\nconst r = $json;\nconst intencion = r.intencion;\nlet texto = String(r.respuesta ?? r.output ?? r.text ?? '').trim();\n// 1) nunca filtrar códigos de otros estudiantes ni correos\ntexto = texto.replace(/U\\d{8}/gi, m => m.toUpperCase() === req.codigoEstudiante ? m : '[código oculto]');\ntexto = texto.replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '[correo oculto]');\n// 2) no exponer detalles técnicos internos\nif (/(stack trace|traceback|psycopg|SQLSTATE|ECONNREFUSED|api[_ ]?key)/i.test(texto)) {\n  texto = 'Tuve un problema técnico consultando la información. Intenta de nuevo en unos minutos.';\n}\n// 3) longitud y vacío\nif (!texto) texto = 'No encontré información para responder eso. ¿Puedes reformular la pregunta?';\nif (texto.length > 2500) texto = texto.slice(0, 2500) + '…';\nreturn [{ json: {\n  ...req, intencion: req.bloqueado ? 'bloqueado' : (intencion || 'general'),\n  respuesta: texto, fuentes: r.fuentes ?? [],\n}}];"
      }
    },
    {
      "id": "778c9bdf-26ae-5de2-be32-30b8a1c0fed6",
      "name": "Log chat",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO academico.chat_log (session_id, codigo_estudiante, intencion, mensaje, respuesta, bloqueado, motivo_bloqueo) VALUES ($1, $2, $3, $4, $5, $6, $7)",
        "options": {
          "queryReplacement": "={{ [ $json.sessionId, $json.codigoEstudiante, $json.intencion, $json.mensaje, $json.respuesta, $json.bloqueado, $json.motivo ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "credPgUnab000001",
          "name": "Postgres UNAB"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
