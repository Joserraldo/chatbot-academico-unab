{
  "id": "wf05IngestaRAG00",
  "name": "05 Ingesta RAG (chunking + embeddings)",
  "active": false,
  "nodes": [
    {
      "id": "1f497395-1b27-505b-a14d-65f7f56b680b",
      "name": "Nota 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        20
      ],
      "parameters": {
        "content": "## 05 Ingesta y embeddings\nEjecutar manualmente cada vez que cambien los documentos de `data/docs_ccd/`.\nLee los .md → extrae texto → **chunking** (800/120) → **embeddings** → PGVector (`rag_documentos`).\nPublica el nuevo índice solo después de insertar los fragmentos.",
        "width": 520,
        "height": 200
      }
    },
    {
      "id": "88ff69cb-941e-5c1c-86f2-b3e62eca3d9d",
      "name": "Ejecutar ingesta",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "76400e83-bc5a-5744-87ad-cffde1212838",
      "name": "Leer documentos",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        400,
        300
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/files/docs_ccd/*.md",
        "options": {}
      },
      "executeOnce": false
    },
    {
      "id": "9b8034e8-4327-58e4-a2f9-61a7bfd2d554",
      "name": "Extraer texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        600,
        300
      ],
      "parameters": {
        "operation": "text",
        "options": {}
      }
    },
    {
      "id": "4bd50624-1b5a-5939-b591-f9f3094a175c",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "jsCode": "// Une el texto extraído con el nombre del archivo para guardarlo como metadata.source\nconst archivos = $('Leer documentos').all();\nreturn $input.all().map((it, i) => ({ json: {\n  text: String(it.json.data ?? ''),\n  source: archivos[i]?.binary?.data?.fileName ?? `documento_${i + 1}.md`,\n}}));"
      }
    },
    {
      "id": "e257f044-f6a8-5d5c-b47d-fa06a13fa949",
      "name": "PGVector insertar",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.1,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "mode": "insert",
        "tableName": "=rag_ingesta_{{ $execution.id }}",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "credPgUnab000001",
          "name": "Postgres UNAB"
        }
      },
      "executeOnce": false
    },
    {
      "id": "264988d3-d75a-5894-9803-c3a571e840c1",
      "name": "Publicar índice",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1270,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=DO $$ BEGIN\nPERFORM pg_advisory_xact_lock(118062);\nIF NOT EXISTS (SELECT 1 FROM public.rag_ingesta_{{ $execution.id }}) THEN\n  RAISE EXCEPTION 'La ingesta no produjo fragmentos';\nEND IF;\nDROP TABLE IF EXISTS public.rag_documentos;\nALTER TABLE public.rag_ingesta_{{ $execution.id }} RENAME TO rag_documentos;\nEND $$;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "credPgUnab000001",
          "name": "Postgres UNAB"
        }
      },
      "executeOnce": true
    },
    {
      "id": "311be8fd-f3a7-5de2-992a-e9159ee71c1b",
      "name": "Embeddings",
