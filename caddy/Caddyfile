# HTTPS automático con Let's Encrypt para el dominio DuckDNS.
# Requisitos: el dominio apunta a la Elastic IP y los puertos 80/443 están abiertos.
# (Sin directiva email global: Let's Encrypt no la exige y con ACME_EMAIL vacío Caddy no arranca.)

{$DOMAIN} {
	encode gzip

	# MCP server también disponible por HTTPS en /mcp (además del puerto 9000)
	handle /mcp* {
		reverse_proxy mcp-server:9000
	}

	# v2: API de servicios (reservas, pagos Bold, QR, gráficas, visión, analítica)
	handle /api/* {
		reverse_proxy servicios-api:8000
	}

	# La raíz del dominio abre el chat; el editor de n8n sigue en /home/workflows y /signin
	redir / /app/ 302

	# Chat web, checkout embebido, analítica y presentación
	redir /app /app/ 308
	handle_path /app/* {
		root * /srv/web
		file_server
	}

	# n8n: editor, webhooks (/webhook/chat) y API
	handle {
		reverse_proxy n8n:5678
	}
}
